{
  "uid": "rift-verification-plane",
  "title": "Rift Cluster / Verification Plane",
  "tags": [
    "rift-cluster"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Journal entries (fleet)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rift-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rift-prometheus"
          },
          "expr": "rift:journal_entries:sum",
          "legendFormat": "entries",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Sum of rift_cluster_journal_entries{port} across the fleet."
    },
    {
      "id": 2,
      "title": "Journal eviction rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rift-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rift-prometheus"
          },
          "expr": "rift:journal_evictions:rate5m",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Rate of rift_cluster_journal_evictions_total, 5-minute window."
    },
    {
      "id": 3,
      "title": "Pull-on-miss checks",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rift-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rift-prometheus"
          },
          "expr": "rate(rift_cluster_pull_on_miss_checks_total[5m])",
          "legendFormat": "checks/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "No recording rule exists for the pull-on-miss family yet, so this queries rift_cluster_pull_on_miss_checks_total directly. Rate of no-match requests the safety net inspected."
    },
    {
      "id": 4,
      "title": "Pull-on-miss lagging",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rift-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rift-prometheus"
          },
          "expr": "rate(rift_cluster_pull_on_miss_lagging_total[5m])",
          "legendFormat": "lagging/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Raw metric (no recording rule yet). Rate of checks that found this node behind on replication."
    },
    {
      "id": 5,
      "title": "Pull-on-miss retries",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rift-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rift-prometheus"
          },
          "expr": "rate(rift_cluster_pull_on_miss_retries_total[5m])",
          "legendFormat": "retries/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Raw metric (no recording rule yet). This is also the series that bounds the Latency Analytics dashboard's match-rate overcount."
    },
    {
      "id": 7,
      "title": "Merged reads stamped partial",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rift-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rift-prometheus"
          },
          "expr": "rift:journal_partial_reads:rate5m",
          "legendFormat": "partial reads/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Rate of merge-on-read answers stamped Rift-Cluster-Partial. Zero is the healthy steady state; this panel exists so that non-zero is seen rather than inferred from a response header nobody is watching. A sustained non-zero rate means a rostered peer is unreachable or over budget, and verification reads may be missing recent entries. Alerts as RiftJournalReadsDegraded after 10m."
    },
    {
      "id": 8,
      "title": "Journal merge latency (in-memory)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rift-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rift-prometheus"
          },
          "expr": "rift:journal_merge_seconds:p95",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rift-prometheus"
          },
          "expr": "rift:journal_merge_seconds:p99",
          "legendFormat": "p99",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Duration of one in-memory k-way merge across this node's cached shards. NOT the peer fan-out: that is a separate phase with a ~2s budget and no histogram, so nothing here indicates budget pressure. The registered buckets top out at 0.5s because this is a sort over retained entries, not I/O. Read it as merge cost growing with shard count or entry volume."
    },
    {
      "id": 9,
      "title": "Peer pull failures by peer",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rift-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rift-prometheus"
          },
          "expr": "rift:journal_peer_pull_failures:rate5m",
          "legendFormat": "peer {{peer}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Rate of failed anti-entropy journal pulls, kept per peer. The label is the diagnostic: one elevated line means one bad node, every line elevated means this node is partitioned from the fleet. Failures that do not degrade a read are the replica cache working, which is why this panel does not alert on its own."
    },
    {
      "id": 10,
      "title": "Proxy claim outcomes",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rift-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rift-prometheus"
          },
          "expr": "rift:proxy_claims:rate5m",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "How the fleet is answering proxyOnce claims. granted = the request won the right to record; inflight = a concurrent winner already exists, so the request proxies without recording; already_recorded = replay. Watch the ratio rather than the absolute rates: a rising inflight share is contention on one signature, and that is normal under concurrent load. granted running persistently above the recordings panel means claims are being handed out and given back, which the releases panel beside this one explains."
    },
    {
      "id": 11,
      "title": "Proxy claim releases",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rift-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rift-prometheus"
          },
          "expr": "rift:proxy_claim_releases:rate5m",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "The ledger of claims given back, and the reason granted need not equal recorded. upstream_failure is the system under test failing the winner's call; deadline is a crashed or wedged winner whose Pending claim aged out. Both are the mock fleet correctly observing something else misbehave. publish_failure is the reason that indicts this system rather than its user: the upstream call already succeeded, and the recording then failed to publish to consensus OR WAS REFUSED - a committed refusal such as a deleted imposter or an exhausted quota lands here too. Either way the exchange is lost rather than delayed. That label alone pages, as RiftProxyRecordingsFailing after 10m."
    },
    {
      "id": 12,
      "title": "Recordings vs granted claims",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rift-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rift-prometheus"
          },
          "expr": "rift:proxy_recordings:rate5m",
          "legendFormat": "recordings/s",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rift-prometheus"
          },
          "expr": "rift:proxy_claims:rate5m{outcome=\"granted\"}",
          "legendFormat": "granted claims/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Plotted together for comparison, but NOT a 1:1 pair, and reading them as one is the mistake this panel exists to preempt. Recordings counts proxyOnce completions AND proxyAlways merges, while granted counts only proxyOnce claims, so any proxyAlways traffic puts recordings above granted with nothing wrong. The meaningful comparison is the gap between them against the releases panel: claims granted and not recorded should be accounted for by a release, and a persistent gap that releases do not explain is a leak."
    }
  ],
