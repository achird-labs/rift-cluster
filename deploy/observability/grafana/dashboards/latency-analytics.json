      "title": "Upstream latency (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rift-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rift-prometheus"
          },
          "expr": "rift:upstream_latency_ms:p50",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rift-prometheus"
          },
          "expr": "rift:upstream_latency_ms:p95",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rift-prometheus"
          },
          "expr": "rift:upstream_latency_ms:p99",
          "legendFormat": "p99",
