    },
    {
      "id": 6,
      "title": "Request rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rift-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rift-prometheus"
          },
          "expr": "rift:requests:rate1m",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Fleet request rate, 1-minute window."
    },
    {
      "id": 7,
      "title": "Match rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rift-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rift-prometheus"
          },
          "expr": "rift:match_rate:ratio5m",
          "legendFormat": "match rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Reads slightly HIGH: the underlying unmatched counter misses requests that were retried by pull-on-miss and missed again, so a retried-then-still-unmatched request is not counted as unmatched here. The undercount is bounded by rate(rift_cluster_pull_on_miss_retries_total[5m]) \u2014 see the Verification Plane dashboard for that series."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Match-rate overstatement ceiling",
      "description": "How much `rift:match_rate:ratio5m` above may be reading HIGH. The unmatched counter misses requests that pull-on-miss retried and that then missed again, so match rate is optimistic by at most this much. Normalised by request rate deliberately: the raw retry rate bounds the undercount on the COUNTER, not the error on a 0..1 RATIO, and at low traffic the un-normalised figure understates the error badly.",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rift-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rift-prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(rift_cluster_pull_on_miss_retries_total[5m])) / sum(rate(rift_requests_total[5m]))",
          "legendFormat": "max overstatement"
        }
      ]
    }
  ],
